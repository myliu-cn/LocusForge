LOCUS_DATA_DIR=./data
LOCUS_CONDA_ENV=locusforge
LOCUS_HOST=127.0.0.1
LOCUS_PORT=8765
# Set an absolute executable path if Blender is not on PATH.
LOCUS_BLENDER=blender
LOCUS_RENDER_THREADS=4
LOCUS_EMBEDDED_WORKER=true
LOCUS_MAX_ASSET_MB=1024
LOCUS_JOB_TIMEOUT_SECONDS=21600
# Required for any non-loopback bind. Do not commit a real token.
LOCUS_API_TOKEN=
# Comma-separated exact origins, required when using a separate UI origin.
LOCUS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCUS_TRUSTED_HOSTS=localhost,127.0.0.1
# For TLS termination, trust only the actual reverse proxy's IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional, OpenAI-compatible motion parsing. Templates/blocks/local grammar need no API.
# Secrets never enter the browser, saved recipes, render children or exported datasets.
LOCUS_LLM_ENDPOINT=https://www.dmxapi.cn/v1/chat/completions
LOCUS_LLM_MODEL=gpt-5.4-mini
LOCUS_LLM_KEY_FILE=./api.key
LOCUS_LLM_API_KEY=
LOCUS_LLM_TIMEOUT_SECONDS=45
LOCUS_LLM_DAILY_LIMIT=20
